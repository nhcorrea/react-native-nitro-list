{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "nitrolist"
  ],
  "ios": {
    "iosModuleName": "NitroList"
  },
  "android": {
    "androidNamespace": [
      "nitrolist"
    ],
    "androidCxxLibName": "NitroList"
  },
  "autolinking": {
    "NitroListScrollView": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridNitroListScrollView"
      }
    },
    "NitroListEngine": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridNitroListEngine"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
