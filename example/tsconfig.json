{
  "extends": "@react-native/typescript-config",
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods"
  ],
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@nhcorrea/react-native-nitro-list": [
        "../lib/typescript/module/src"
      ],
      "@nhcorrea/react-native-nitro-list/*": [
        "../lib/typescript/module/src/*"
      ]
    }
  }
}
